  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Pool Utilization",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "description": "Current DHCP pool utilization per interface. Green < 80%, yellow 80-90%, red > 90%.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "#EAB839", "value": 0.8 },
              { "color": "red", "value": 0.9 }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "minVizHeight": 75,
        "minVizWidth": 75,
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "sizing": "auto"
      },
      "pluginVersion": "12.2.1",
      "targets": [
        {
          "expr": "pfsense_dhcp_pool_utilization{instance=~\"$instance\", job=~\"$job\", host=~\"$host\", interface=~\"$interface\"}",
          "legendFormat": "{{host}} - {{interface}}",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "$datasource" }
        }
      ],
      "title": "Pool Utilization",
      "transparent": true,
      "type": "gauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "description": "Active leases vs total pool capacity per interface.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 0 }
            ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Pool Size" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "text", "mode": "fixed" } }
            ]
          }
        ]
      },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 1 },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "value_and_name",
        "wideLayout": true
      },
      "pluginVersion": "12.2.1",
      "targets": [
        {
          "expr": "pfsense_dhcp_leases_active{instance=~\"$instance\", job=~\"$job\", host=~\"$host\", interface=~\"$interface\"}",
          "legendFormat": "{{interface}} Active",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "$datasource" }
        },
        {
          "expr": "pfsense_dhcp_pool_size{instance=~\"$instance\", job=~\"$job\", host=~\"$host\", interface=~\"$interface\"}",
          "legendFormat": "{{interface}} Pool Size",
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "$datasource" }
        }
      ],
      "title": "Active Leases / Pool Size",
      "transparent": true,
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "description": "DHCP pool utilization over time per interface.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 20,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "insertNulls": false,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": {
              "mode": "dashed",
              "lineColor": "red"
