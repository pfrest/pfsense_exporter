  "schemaVersion": 40,
  "tags": ["pfsense", "networking", "pfrest"],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Prometheus",
          "value": "Prometheus",
          "selected": true
        },
        "hide": 2
      },
      {
        "name": "job",
        "label": "Job",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "$datasource" },
        "query": {
          "query": "label_values(up, job)",
          "refId": "Prometheus-job"
        },
        "refresh": 2,
        "allValue": ".+",
        "includeAll": true,
        "multi": true,
        "hide": 0
      },
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "$datasource" },
        "query": {
          "query": "label_values(pfsense_dhcp_server_enabled{job=~\"$job\"}, instance)",
          "refId": "Prometheus-instance"
        },
        "refresh": 2,
        "allValue": ".+",
        "includeAll": true,
        "multi": true
      },
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "$datasource" },
        "query": {
          "qryType": 1,
          "query": "label_values(pfsense_dhcp_pool_size, host)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "sort": 1
      },
      {
        "name": "interface",
        "label": "Interface",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "$datasource" },
        "query": {
          "qryType": 1,
          "query": "label_values(pfsense_dhcp_pool_size{host=~\"$host\"}, interface)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "allValue": ".+",
        "includeAll": true,
        "multi": true,
        "sort": 1
      }
    ]
  },
