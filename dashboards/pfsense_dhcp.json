        "overrides": []
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 7 },
      "id": 3,
      "options": {
        "legend": {
          "calcs": ["mean", "max", "lastNotNull"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "pluginVersion": "12.2.1",
      "targets": [
        {
          "expr": "pfsense_dhcp_pool_utilization{instance=~\"$instance\", job=~\"$job\", host=~\"$host\", interface=~\"$interface\"}",
          "legendFormat": "{{host}} - {{interface}}",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "$datasource" }
        }
      ],
      "title": "Pool Utilization Over Time",
      "transparent": true,
      "type": "timeseries"
    },
