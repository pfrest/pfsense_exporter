      }
    ]
  },
  "description": "Displays visualizations for DHCP server metrics.",
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [
    {
      "asDropdown": true,
      "icon": "external link",
      "includeVars": true,
      "keepTime": true,
      "tags": ["pfsense", "networking", "pfrest"],
      "targetBlank": false,
      "title": "pfSense Dashboards",
